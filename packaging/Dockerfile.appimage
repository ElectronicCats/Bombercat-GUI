# Construye un AppImage de EMVy Controller (GUI) en Ubuntu 22.04 (glibc antigua =
# más portable). PyInstaller empaqueta la app + firmware; appimagetool crea el
# .AppImage. El artefacto queda en /out (montar un volumen ahí al ejecutar).
#
#   docker build -f packaging/Dockerfile.appimage -t emvy-appimage .
#   docker run --rm -v "$PWD/dist:/out" emvy-appimage
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv python3-dev \
        build-essential swig \
        libpcsclite-dev pcscd \
        libgl1 libegl1 libxkbcommon0 libdbus-1-3 \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        fontconfig fonts-dejavu-core \
        librsvg2-bin file wget ca-certificates fuse \
    && rm -rf /var/lib/apt/lists/*

# appimagetool (se extrae para no depender de FUSE dentro del contenedor).
RUN wget -q https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage \
        -O /opt/appimagetool.AppImage \
    && chmod +x /opt/appimagetool.AppImage \
    && cd /opt && ./appimagetool.AppImage --appimage-extract >/dev/null \
    && mv squashfs-root /opt/appimagetool

WORKDIR /src
COPY . /src

# Deps de la app + PyInstaller. GUI (PySide6) + lectores (pyscard, pyserial).
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir pyinstaller \
    && python3 -m pip install --no-cache-dir ".[gui]" pyserial

# Empaqueta con PyInstaller (onedir).
RUN pyinstaller --noconfirm --clean packaging/EMVyController.spec

# Monta el AppDir y genera el AppImage.
RUN VER=$(python3 -c "import emvy; print(emvy.__version__)") \
    && APPDIR=/build/EMVyController.AppDir \
    && mkdir -p "$APPDIR/usr/bin" "$APPDIR/usr/share/icons/hicolor/256x256/apps" \
    && cp -r dist/EMVyController/* "$APPDIR/usr/bin/" \
    && rsvg-convert -w 256 -h 256 packaging/emvy.svg -o "$APPDIR/emvy.png" \
    && cp "$APPDIR/emvy.png" "$APPDIR/usr/share/icons/hicolor/256x256/apps/emvy.png" \
    && printf '%s\n' \
        '[Desktop Entry]' 'Type=Application' 'Name=EMVy Controller' \
        'Comment=EMV security testing & card exploration (BETA)' \
        'Exec=EMVyController' 'Icon=emvy' 'Categories=Development;Utility;' \
        'Terminal=false' > "$APPDIR/emvy.desktop" \
    && cp "$APPDIR/emvy.desktop" "$APPDIR/usr/share/applications_emvy.desktop" 2>/dev/null || true \
    && cp -r /etc/fonts "$APPDIR/etc-fonts" \
    && printf '%s\n' '#!/bin/sh' \
        'HERE="$(dirname "$(readlink -f "$0")")"' \
        '# Usa una config de fontconfig de versión compatible (la del bundle) para' \
        '# evitar el ruido "invalid attribute xsi:nil / invalid constant" cuando el' \
        '# fontconfig del host es más nuevo (2.15+) que el enlazado en Qt.' \
        'export FONTCONFIG_PATH="$HERE/etc-fonts"' \
        'export FONTCONFIG_FILE="$HERE/etc-fonts/fonts.conf"' \
        'exec "$HERE/usr/bin/EMVyController" "$@"' > "$APPDIR/AppRun" \
    && chmod +x "$APPDIR/AppRun" \
    && ARCH=x86_64 /opt/appimagetool/AppRun --no-appstream "$APPDIR" \
        "/build/EMVy_Controller-${VER}-beta-x86_64.AppImage"

# Al ejecutar el contenedor: copia el AppImage al volumen /out.
CMD sh -c 'mkdir -p /out && cp /build/*.AppImage /out/ && ls -la /out'
